# live in demo/packs/ as zips.
appdata/volunteer_packs/

# runtime uploads and corpus exports (created at deploy time)
appdata/uploads/
appdata/exports/

# derived pack test dirs (materialized on demand from volunteer_packs
# private metas) and their captures
appdata/tests/pack-*/

# campaign data provisioned at runtime on this machine (large / personal)
appdata/tests/neet-2018-physics-print-photograph-test-b36e/
appdata/tests/niraj-kasar-resume-2025-1-3bc5/

