# Copy to .env and fill in. Used by docker-compose.

# ============================================================================
# DATA & BACKUPS (read this)
# All tracing ability lives in one data directory: the per-copy ground truth
# and sealed commitments. With Docker, that is the ./data folder mounted below
# (data under ./data/appdata/); running directly it is ./appdata/. LOSING IT
# (reinstall, disk failure, deleting the folder) PERMANENTLY DESTROYS the
# ability to trace any document this instance has generated. Back it up.
# ============================================================================

# Public origin of the app. The defaults below are for LOCAL EVALUATION.
# FOR A PUBLIC DEPLOYMENT, set both to your real domain, e.g.
#   DOMAIN=fp.example.org
#   BASE_URL=https://fp.example.org
# Caddy then obtains HTTPS automatically for DOMAIN. An https BASE_URL is
# required in production and also hard-disables the local dev sign-in below,
# so a real deployment cannot leave it on by accident. (DOMAIN must match the
# Google OAuth redirect URI https://$DOMAIN/auth/callback.)
DOMAIN=localhost
BASE_URL=http://localhost

# Google OAuth 2.0 client — how users sign in on a public deployment.
# (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application"; authorized redirect URI: https://$DOMAIN/auth/callback.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session-cookie signing key. Generate with:  openssl rand -hex 32
SECRET_KEY=

# Comma-separated emails that get the admin dashboard + corpus export.
# For local evaluation, set this to the email you will sign in with.
ADMIN_EMAILS=you@example.org

# LOCAL EVALUATION ONLY -- the built-in dev sign-in, no Google account needed.
# Uncomment to try the app locally, then sign in with an ADMIN_EMAILS address.
# NEVER enable this on a public deployment; use Google OAuth (above) instead.
# It is refused automatically whenever GOOGLE_CLIENT_ID is set or BASE_URL is
# https, so switching to a real (https) domain turns it off on its own.
#FF_DEV_LOGIN=1

# Optional knobs (defaults shown).
#FF_MAX_VARIANTS=5
#FF_MAX_PDF_PAGES=10
#FF_QUOTA_TESTS_PER_DAY=5
#FF_QUOTA_SCANS_PER_DAY=30
# Address-space ceiling (MB) for the isolated PDF-processing subprocess.
# RLIMIT_AS caps VIRTUAL address space, not resident memory; OpenCV/OpenBLAS
# reserve large virtual arenas, so the raster/vector carriers peak at ~3.5 GB
# virtual (only ~0.5 GB RSS). Sized to that with headroom; raise for very
# large scanned PDFs. (Linux only; a no-op on Windows.)
#FF_PDF_WORKER_MEM_MB=4096
