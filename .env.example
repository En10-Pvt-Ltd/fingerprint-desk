# Copy to .env and fill in. Used by docker-compose.

# ============================================================================
# DATA & BACKUPS (read this)
# All tracing ability lives in one data directory: the per-copy ground truth
# and sealed commitments. With Docker, that is the ./data folder mounted below
# (data under ./data/appdata/); running directly it is ./appdata/. LOSING IT
# (reinstall, disk failure, deleting the folder) destroys the ability to trace
# any document this instance generated -- UNLESS you exported a recovery key for
# that campaign first (a portable, encryptable backup of its ground truth; see
# docs/recovery-key-format.md). Back up this directory, and export a recovery
# key + deposit the commitment receipt for campaigns that matter.
# ============================================================================

# Deployment mode (see MIGRATION.md).
#   server = network deployment with email+password accounts: the first
#            visit runs a one-time setup that creates the admin account,
#            and further accounts are created via admin invite links.
#   local  = single-operator run on THIS machine only (no accounts; the
#            server refuses to bind to anything but loopback).
# Docker deployments are server mode (docker-compose pins FF_MODE=server).
# When FF_MODE is unset the app only starts for an unambiguously local
# configuration (loopback HOST, non-https BASE_URL); anything else refuses
# to start rather than guessing.
FF_MODE=server

# Public origin of the app. The defaults below are for LOCAL EVALUATION.
# FOR A PUBLIC DEPLOYMENT, set both to your real domain, e.g.
#   DOMAIN=fp.example.org
#   BASE_URL=https://fp.example.org
# Caddy then obtains HTTPS automatically for DOMAIN.
DOMAIN=localhost
BASE_URL=http://localhost

# Session-cookie signing key. Generate with:  openssl rand -hex 32
SECRET_KEY=

# Admin accounts live in the database (the first-run setup creates
# the first one). ADMIN_EMAILS is only a bootstrap SEED kept for upgrades
# from older versions: at startup it grants the persistent admin flag to
# EXISTING users with these emails, and it can flag the very first admin
# while none exists. Once any admin exists it never elevates anyone.
# Safe to leave empty on a fresh install.
ADMIN_EMAILS=

# Optional knobs (defaults shown).
#FF_MAX_VARIANTS=5
#FF_MAX_PDF_PAGES=10
#FF_QUOTA_TESTS_PER_DAY=5
#FF_QUOTA_SCANS_PER_DAY=30
# Address-space ceiling (MB) for the isolated PDF-processing subprocess.
# RLIMIT_AS caps VIRTUAL address space, not resident memory; OpenCV/OpenBLAS
# reserve large virtual arenas, so the raster/vector carriers peak at ~3.5 GB
# virtual (only ~0.5 GB RSS). Sized to that with headroom; raise for very
# large scanned PDFs. (Linux only; a no-op on Windows.)
#FF_PDF_WORKER_MEM_MB=4096
